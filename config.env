# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/SushiKernel/android_kernel_motorola_fogos.git
KERNEL_SOURCE_BRANCH=resukisu
KERNEL_CONFIG=vendor/fogos_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS: LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS: CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==

CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

USE_LLVM=true

# ===================================================================== GCC ==

ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false

# =============================================================== KernelSU ===

KSU_VARIANT=none
KSU_REF=
NON_GKI_MANUAL_HOOK=false
KSU_HOOK_MODE=none

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==

ENABLE_SUSFS=true
SUSFS_REPO=
SUSFS_BRANCH=

# ========================================================== Extra patches ===

ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_LTO=true
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false

# ============================================================== Packaging ===

NEED_DTBO=true
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://github.com/eduseb86/motofiles/raw/refs/heads/main/boot.img

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
